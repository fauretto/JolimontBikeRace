<Window x:Class="JolimontBikeRace.App.Views.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Width="440" Height="200"
        Background="{StaticResource AccentBrush}" Icon="/Assets/race.ico">
    <Border Padding="28">
        <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Image Source="/Assets/race-logo.png" Width="64" Height="64" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock x:Name="RaceNameText" FontSize="22" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280" />
            </StackPanel>
            <TextBlock Text="Checking the database, please wait..." FontSize="14" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,14" />
            <ProgressBar IsIndeterminate="True" Height="6" Width="320" />
        </StackPanel>
    </Border>
</Window>
