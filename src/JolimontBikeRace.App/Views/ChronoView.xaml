<UserControl x:Class="JolimontBikeRace.App.Views.ChronoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:JolimontBikeRace.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Chrono" Style="{StaticResource SectionHeaderStyle}" />

        <!-- Race selection, clock and start button. -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <ComboBox ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRace}"
                              DisplayMemberPath="Name" Width="280" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding ElapsedTime}" FontSize="56" FontWeight="Bold"
                               Foreground="{StaticResource AccentDarkBrush}" />
                    <TextBlock Text="{Binding CurrentTimeOfDay, StringFormat='Current time: {0}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Start Race" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding StartRaceCommand}" VerticalAlignment="Top" FontSize="16" Padding="24,12" />
            </Grid>
        </Border>

        <!-- The prominent bib-number entry box. -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="BibNumberTextBox" Text="{Binding BibNumberInputText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="32" Padding="16,12"
                         PreviewKeyDown="BibNumberTextBox_OnPreviewKeyDown" />
                <TextBlock Text="Type bib number and press Enter — press Space alone for an unassigned crossing"
                           IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0" FontSize="18"
                           Visibility="{Binding BibNumberInputText, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>
        </Border>

        <!-- Crossings grid, newest first. -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding Crossings}" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sequence" Binding="{Binding SequenceIndex}" IsReadOnly="True" Width="1*" />
                        <DataGridTextColumn Header="Time Of Day" Binding="{Binding TimeOfDayText}" IsReadOnly="True" Width="1*" />
                        <DataGridTextColumn Header="Race Time" Binding="{Binding RaceTimeText}" IsReadOnly="True" Width="1*" />
                        <DataGridTextColumn Header="Bib Number" Binding="{Binding BibNumberText}" IsReadOnly="True" Width="1*" />
                        <DataGridTextColumn Header="Rider" Binding="{Binding BikerFullName}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Lap" Binding="{Binding LapNumber}" IsReadOnly="True" Width="1*" />
                        <DataGridTemplateColumn Header="Assign Bib" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBibNumberAssigned}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBox Width="70" Text="{Binding PendingBibNumberText, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="Assign" Margin="6,0,0,0"
                                                Command="{Binding DataContext.AssignBibNumberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="1" Content="Undo Last Crossing" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding UndoLastCrossingCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <!-- Bottom bar: autosave / database status and journal / reset actions. -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding AutosaveStatusText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastSaveTime, StringFormat=' — Last save: {0:HH:mm:ss}'}"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Load Journal" Command="{Binding LoadJournalCommand}" Margin="0,0,8,0" />
                    <Button Content="Force Database Sync" Command="{Binding ForceDatabaseSynchronizationCommand}" Margin="0,0,8,0" />
                    <Button Content="Reset Crossings" Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetRaceStandingsCommand}" Margin="0,0,8,0" />
                    <Button Content="Reset Race" Style="{StaticResource DangerButtonStyle}" Command="{Binding ResetRaceCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
